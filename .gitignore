# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Credentials. Never commit; rotate if ever exposed.
.env
*.key
video/.elevenlabs_key

# Local runtime state: SQLite stores, write-once raw payloads, fleet logs,
# calibration output, and machine-generated evidence reports.
data/

# Frontend dependencies and build output.
dashboard/frontend/node_modules/
dashboard/frontend/dist/

# Generated narration, captions, and rendered recordings.
video/out/
video/out-v2/
video/*.mkv
video/*.mp4

# Superseded local submission drafts and generated diagram variants.
docs/devpost/story-v2.md
docs/devpost/video-and-visuals.md
docs/diagrams/architecture-deepseek*
docs/diagrams/architecture.html
docs/diagrams/fontfaces.min.css
docs/diagrams/hero.py
docs/diagrams/tycho-hero*
video/narration.md

# Editor and OS noise
.DS_Store
*.swp
*.tmp
